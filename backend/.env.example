MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/myntra-clone?retryWrites=true&w=majority
PORT=5000
JWT_SECRET=your_jwt_secret_key_here
ADMIN_SECRET=your_admin_secret_key_here

# Push Notifications (Expo)
EXPO_ACCESS_TOKEN=your_expo_access_token_here

# Payment Gateway Configuration
# Active gateway selector: CASHFREE or RAZORPAY
PAYMENT_GATEWAY=CASHFREE
PAYMENT_GATEWAY_ENVIRONMENT=SANDBOX

# Generic Payment Gateway Variables (Supported)
PAYMENT_GATEWAY_KEY_ID=your_payment_gateway_key_id
PAYMENT_GATEWAY_KEY_SECRET=your_payment_gateway_key_secret
PAYMENT_WEBHOOK_SECRET=your_payment_webhook_secret

# Cashfree Provider-Specific Variables (Supported)
CASHFREE_ENVIRONMENT=SANDBOX
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_WEBHOOK_SECRET=your_cashfree_webhook_secret
